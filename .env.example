# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (Gemini Flash only)
GEMINI_API_KEY=
GEMINI_MODEL=                 # a current Flash model ID from AI Studio; do not hardcode
GEMINI_FALLBACK_MODEL=        # optional second Flash model
LLM_MAX_CALLS_PER_RUN=60

# Search
LANGSEARCH_API_KEY=

# Protection (generate with: openssl rand -hex 32)
CRON_SECRET=
ADMIN_TOKEN=

# Tuning
LOOKBACK_DAYS=30
MAX_QUERIES_PER_VC=4
MAX_CANDIDATES_PER_VC=6
BATCH_SIZE=4
MAX_PARALLEL_VCS=3
REQUEST_TIMEOUT_MS=8000
COOLDOWN_DAYS=14

# Workspace + integrations (private features)
APP_URL=http://localhost:3000        # public base URL; used for the Google OAuth redirect
INTEGRATION_ENC_KEY=                 # random secret used to encrypt stored OAuth/API tokens (openssl rand -hex 32)
GOOGLE_CLIENT_ID=                    # Google Cloud OAuth client (Gmail + Calendar), optional
GOOGLE_CLIENT_SECRET=
SUPABASE_ACCESS_TOKEN=               # only for `npm run migrate` (Supabase personal access token); never needed at runtime
# Set to 'off' to remove the workspace login entirely (anyone with the URL gets full access). Leave unset on a public deployment.
WORKSPACE_AUTH=
