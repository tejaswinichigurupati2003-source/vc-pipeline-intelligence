ADMIN_TOKEN=

# Tuning
LOOKBACK_DAYS=30
MAX_QUERIES_PER_VC=4
MAX_CANDIDATES_PER_VC=6
BATCH_SIZE=4
MAX_PARALLEL_VCS=3
REQUEST_TIMEOUT_MS=8000
COOLDOWN_DAYS=14
